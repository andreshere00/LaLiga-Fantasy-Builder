APP_NAME=LaLiga Fantasy Builder API
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json
INTERNAL_JWT_ISSUER=https://auth.fantasy-builder.local
INTERNAL_JWT_AUDIENCE=fantasy-api
AUTH_INTERNAL_BASE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=change-me-service-token

LALIGA_FANTASY_ORIGIN=https://fantasy-api.llt-services.com
LALIGA_COMPETITION_ID=1

LOG_LEVEL=INFO
LOG_JSON=true

SCRAPING_BASE_URL=
SCRAPING_SERVICE_TOKEN=
SCRAPING_TIMEOUT_SECONDS=30.0
SCRAPING_MAX_CONCURRENCY=4

OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_TIMEOUT_SECONDS=5.0

PLAYER_CATALOG_TTL_SECONDS=900
SCRAPED_PLAYER_TTL_SECONDS=900
WEATHER_TTL_SECONDS=1800
MARKET_HISTORY_TTL_SECONDS=300
TEAMS_MASTER_TTL_SECONDS=86400
PLAYER_STATS_RATE_LIMIT_PER_MINUTE=60
