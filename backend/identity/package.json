{
  "name": "fantasy-builder-identity",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "schema:generate": "auth generate --config src/runtime.ts --output migrations/schema.sql --yes",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "express": "5.3.0",
    "jose": "6.2.13",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "auth": "1.7.12",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7",
    "esbuild": "0.28.1"
  }
}
