project_id = "your-existing-project-id"
# Region and zone must change together.
region       = "us-central1"
zone         = "us-central1-a"
domain       = "fantasybuilder.es"
machine_type = "e2-small"
admin_members = [
  "user:your-google-account@example.com",
]

# Optional: this needs permission to create budgets on the billing account.
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# budget_currency    = "EUR" # Must match your billing account, not the USD estimate.
# monthly_budget     = 20

# Enable image publishing and automatic development activation after main CI.
# Obtain repository_id: gh api repos/andreshere00/LaLiga-Fantasy-Builder --jq '.id | tostring'
# github_actions = {
#   repository    = "andreshere00/LaLiga-Fantasy-Builder"
#   repository_id = "REPLACE_WITH_NUMERIC_ID"
# }

# Weekly discovery, Wednesday 07:10 Europe/Madrid, on the existing VM.
# Enabled by default. Seed reviewed inputs, catalog/checkpoints and publication
# before deploying; set false to opt out on an unprepared installation.
# radar_discovery_enabled = false
