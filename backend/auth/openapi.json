            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthNotReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "detail"
        ],
        "title": "HealthNotReadyResponse",
        "description": "Readiness response when a dependency is unavailable."
      },
      "HealthReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "store": {
            "type": "string",
            "title": "Store"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "store"
        ],
        "title": "HealthReadyResponse",
