# Upload to <prefix>-api-env. Optional provider credentials belong only here.
# OPENWEATHER_API_KEY=
LINEUP_EXPLANATIONS_ENABLED=false
LOG_LEVEL=INFO
LOG_JSON=true
# Enable only after publishing and validating the pilot (read-only mount).
RADAR_DATASET_ROOT=/data/radar/published
RADAR_STALE_DAYS=8
RADAR_MAXIMUM_DAYS=30
