          },
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "linked"
        ],
        "title": "ConnectionStatusResponse",
