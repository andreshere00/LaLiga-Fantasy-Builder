          "browser_available": {
            "type": "boolean",
            "title": "Browser Available"
          },
          "manual_available": {
            "type": "boolean",
            "title": "Manual Available"
          },
          "helper_available": {
            "type": "boolean",
            "title": "Helper Available"
          },
          "helper_platforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Helper Platforms"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "browser_available",
          "manual_available",
          "helper_available",
          "helper_platforms",
          "user_id"
        ],
        "title": "LinkOptionsResponse",
        "description": "Available account-linking methods for this deployment."
      },
      "ManualCompleteRequest": {
        "properties": {
          "callback": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 20,
            "title": "Callback"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "callback"
        ],
        "title": "ManualCompleteRequest",
        "description": "Single-use native callback pasted into the browser linking page."
      },
      "ManualStartResponse": {
        "properties": {
          "authorize_url": {
            "type": "string",
            "title": "Authorize Url"
          },
          "expires_at": {
            "type": "integer",
            "minimum": 1.0,
