# Upload this file to <prefix>-runtime-env. Generate each value independently.
# Use URL-safe passwords: openssl rand -hex 32
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
APP_DB_PASSWORD=
SCOUTING_SERVICE_TOKEN=
VAULT_DB_PASSWORD=
INTERNAL_SERVICE_TOKEN=
SCRAPING_SERVICE_TOKEN=
# Copy the registry prefix from terraform output -raw registry.
# Build all five images for linux/amd64 and use their immutable sha256 digests.
IDENTITY_IMAGE=
AUTH_IMAGE=
API_IMAGE=
SCRAPING_IMAGE=
FRONTEND_IMAGE=

# Keep these equal to radar.env if overriding the default host mounts.
# RADAR_DATA_DIR=/var/lib/fantasybuilder/radar
# RADAR_REVIEW_DIR=/var/lib/fantasybuilder/radar-review
