# Application (LaLiga Fantasy Builder — Auth service)
APP_NAME=LaLiga Fantasy Builder Auth
DEBUG=false
USE_MEMORY_STORE=true

# Allowed browser origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Browser app opened after native pairing.
FRONTEND_ORIGIN=http://localhost:3000

# Pairing
PAIRING_TTL_SECONDS=600
PAIRING_RATE_LIMIT_PER_MINUTE=10

# Token vault (required when USE_MEMORY_STORE=false): openssl rand -base64 32
TOKEN_VAULT_KEY_BASE64=

# Production persistence (required when USE_MEMORY_STORE=false)
DATABASE_URL=postgresql://fantasy_vault:vault_dev@localhost:5432/fantasy_auth
REDIS_URL=redis://localhost:6379/0
MIGRATION_AUTO_APPLY=true

# Observability
OTEL_SERVICE_NAME=laliga-fantasy-builder-auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=INFO
LOG_JSON=true

# Cross-service internal JWT (required when USE_MEMORY_STORE=false)
INTERNAL_JWT_ISSUER=http://localhost:3000/auth
INTERNAL_JWT_AUDIENCE=fantasy-api
INTERNAL_SERVICE_TOKEN=change-me-service-token

# LaLiga B2C (public client ID; no client_secret observed)
LALIGA_CLIENT_ID=af88bcff-1157-40a0-b579-030728aacf0b
LALIGA_SIGNIN_POLICY=B2C_1A_5ULAIP_PARAMETRIZED_SIGNIN
LALIGA_BASE_URL=https://login.laliga.es/laligadspprob2c.onmicrosoft.com/oauth2/v2.0/token
LALIGA_ISSUER=https://login.laliga.es/335316eb-f606-4361-bb86-35a7edcdcec1/v2.0/
LALIGA_REDIRECT_URI=authredirect://com.lfp.laligafantasy
# Browser linking stays disabled until LaLiga registers this exact HTTPS callback
# for LALIGA_CLIENT_ID. Set FRONTEND_ORIGIN to its matching HTTPS origin.
# LALIGA_BROWSER_REDIRECT_URI=https://app.example.com/laliga/callback
# Advertise the macOS helper only after a consented native-to-cloud trial.
LALIGA_HELPER_ENABLED=false
# Manual desktop DevTools callback copy/paste. Keep disabled until live release gates pass.
LALIGA_MANUAL_LINK_ENABLED=false
LALIGA_FANTASY_ORIGIN=https://fantasy-api.llt-services.com
# LaLiga often returns only id_token for openid+offline_access; Fantasy accepts it.
LALIGA_ALLOW_ID_TOKEN_FALLBACK=true

REFRESH_SKEW_SECONDS=60
AUTH_JWKS_URL=http://localhost:8003/auth/jwks
