# Copy to `.env` at the repository root:
#   cp .env.template .env
#
# Compose only substitutes these names. Service secrets stay in
# backend/auth/.env and backend/api/.env.

# ---- Keycloak ----
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_PUBLISH_PORT=8080
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_HOSTNAME_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM_IMPORT_PATH=./docker/keycloak/realm-fantasy-builder.json

# In-network Keycloak routes (override both if the realm or port changes)
APP_OIDC_TOKEN_URL=http://keycloak:8080/realms/fantasy-builder/protocol/openid-connect/token
APP_OIDC_JWKS_URL=http://keycloak:8080/realms/fantasy-builder/protocol/openid-connect/certs

# ---- Postgres (profile: full) ----
# Keep DATABASE_URL aligned with POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy
POSTGRES_DB=fantasy_auth
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=5432
DATABASE_URL=postgresql://fantasy:fantasy@postgres:5432/fantasy_auth

# ---- Redis (profile: full) ----
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379
REDIS_PUBLISH_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- OpenTelemetry collector (profiles: full, otel) ----
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.120.0
OTEL_COLLECTOR_CONFIG_PATH=./docker/otel/collector-config.yaml
OTEL_COLLECTOR_HTTP_PORT=4318
# Empty disables OTLP export from auth
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Auth (profiles: apps, full) ----
AUTH_SERVICE_PORT=8000
AUTH_PUBLISH_PORT=8000

# ---- API (profiles: apps, full) ----
API_SERVICE_PORT=8001
API_PUBLISH_PORT=8001

# ---- Frontend (profiles: apps, full) ----
FRONTEND_PUBLISH_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
AUTH_JWKS_URL=http://auth:8000/.well-known/jwks.json
AUTH_INTERNAL_BASE_URL=http://auth:8000

# ---- Shared ----
INTERNAL_JWT_ISSUER=https://auth.fantasy-builder.local
INTERNAL_JWT_AUDIENCE=fantasy-api
INTERNAL_SERVICE_TOKEN=dev-service-token
MIGRATION_AUTO_APPLY=false
