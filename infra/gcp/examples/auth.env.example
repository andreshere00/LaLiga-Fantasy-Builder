# Upload to <prefix>-auth-env. Stable 32-byte AES key: openssl rand -base64 32
TOKEN_VAULT_KEY_BASE64=
# Match the existing Auth example: Fantasy accepts the verified LaLiga id_token
# when the native pairing response omits an access_token.
LALIGA_ALLOW_ID_TOKEN_FALLBACK=true
# Browser linking requires an approved LaLiga client and this registered callback.
# LALIGA_BROWSER_REDIRECT_URI=https://fantasybuilder.es/laliga/callback
LOG_LEVEL=INFO
LOG_JSON=true
