# Application (LaLiga Fantasy Builder — Auth service)
APP_NAME=LaLiga Fantasy Builder Auth
DEBUG=false
USE_MEMORY_STORE=true

# Cookies / CORS
COOKIE_SECURE=false
COOKIE_NAME=fantasy_session
CSRF_COOKIE_NAME=fantasy_csrf
# lax is required for OIDC top-level redirects from the IdP; use strict only for
# same-site deployments. none requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Session / pairing
SESSION_TTL_SECONDS=86400
PAIRING_TTL_SECONDS=600
PAIRING_RATE_LIMIT_PER_MINUTE=10

# Token vault (required when USE_MEMORY_STORE=false): openssl rand -base64 32
TOKEN_VAULT_KEY_BASE64=

# Production persistence (required when USE_MEMORY_STORE=false)
DATABASE_URL=postgresql://fantasy:fantasy@localhost:5432/fantasy_auth
REDIS_URL=redis://localhost:6379/0
MIGRATION_AUTO_APPLY=true

# Observability
OTEL_SERVICE_NAME=laliga-fantasy-builder-auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=INFO
LOG_JSON=true

# App OIDC — local Keycloak (docker compose from repo root)
# Admin console: http://localhost:8080 (admin / admin)
# Demo user: demo / demo
APP_OIDC_ISSUER=http://localhost:8080/realms/fantasy-builder
APP_OIDC_CLIENT_ID=laliga-fantasy-builder
APP_OIDC_CLIENT_SECRET=
APP_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
APP_OIDC_AUTHORIZE_URL=http://localhost:8080/realms/fantasy-builder/protocol/openid-connect/auth
APP_OIDC_TOKEN_URL=http://localhost:8080/realms/fantasy-builder/protocol/openid-connect/token
APP_OIDC_JWKS_URL=http://localhost:8080/realms/fantasy-builder/protocol/openid-connect/certs

# LaLiga B2C (public client ID; no client_secret observed)
LALIGA_CLIENT_ID=af88bcff-1157-40a0-b579-030728aacf0b
LALIGA_SIGNIN_POLICY=B2C_1A_5ULAIP_PARAMETRIZED_SIGNIN
LALIGA_BASE_URL=https://login.laliga.es/laligadspprob2c.onmicrosoft.com/oauth2/v2.0/token
LALIGA_ISSUER=https://login.laliga.es/335316eb-f606-4361-bb86-35a7edcdcec1/v2.0/
LALIGA_REDIRECT_URI=authredirect://com.lfp.laligafantasy
LALIGA_FANTASY_ORIGIN=https://fantasy-api.llt-services.com
# LaLiga often returns only id_token for openid+offline_access; Fantasy accepts it.
LALIGA_ALLOW_ID_TOKEN_FALLBACK=true

REFRESH_SKEW_SECONDS=60
