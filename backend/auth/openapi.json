          },
          "manager_id": {
            "type": "string",
            "title": "Manager Id"
          },
          "manager_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manager Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
