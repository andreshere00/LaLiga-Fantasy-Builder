# Reference only: Terraform generates /etc/fantasybuilder/radar.env.
# Enable through radar_discovery_enabled after reviewing the runbook.
RADAR_JOB_ENABLED=false
RADAR_SEASON=2026-27
# Terraform derives the complete club list from the eligibility policy.
RADAR_TEAM_IDS="11 12 13 14 15 16 17 18 2 20 21 26 3 4 49 5 6 7 8 9"
RADAR_MINIMUM_CATALOG_COUNT=750
RADAR_DATA_DIR=/var/lib/fantasybuilder/radar
RADAR_REVIEW_DIR=/var/lib/fantasybuilder/radar-review
RADAR_STALE_DAYS=8
RADAR_MAXIMUM_DAYS=30
# Authorized import inside the read-only review mount; otherwise use approved DataMB tasks.
# RADAR_IMPORTS_FILE=/data/radar-review/imports.json
