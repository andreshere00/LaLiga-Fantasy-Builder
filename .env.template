# Copy to `.env` at the repository root:
#   cp .env.template .env
#
# Compose only substitutes these names. Service secrets stay in
# backend/auth/.env and backend/api/.env.

# ---- Better Auth identity ----
IDENTITY_DB_PASSWORD=identity_dev
# Set production with HTTPS/provider/mail credentials in backend/identity/.env.
IDENTITY_NODE_ENV=development
IDENTITY_SMTP_HOST=mailpit

# ---- Postgres ----
# POSTGRES_USER is bootstrap/admin only; application roles are not superusers.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy
POSTGRES_DB=fantasy_auth
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=5432
VAULT_DB_PASSWORD=vault_dev
DATABASE_URL=postgresql://fantasy_vault:vault_dev@postgres:5432/fantasy_auth

# ---- Redis ----
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379
REDIS_PUBLISH_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- OpenTelemetry collector (profiles: full, otel) ----
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.120.0
OTEL_COLLECTOR_CONFIG_PATH=./docker/otel/collector-config.yaml
OTEL_COLLECTOR_HTTP_PORT=4318
# Empty disables OTLP export from auth
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Auth (profiles: apps, full) ----
AUTH_SERVICE_PORT=8000
AUTH_PUBLISH_PORT=8000

# ---- API (profiles: apps, full) ----
API_SERVICE_PORT=8001
API_PUBLISH_PORT=8001

# ---- Frontend (profiles: apps, full) ----
FRONTEND_PUBLISH_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
AUTH_JWKS_URL=http://identity:8003/auth/jwks
AUTH_INTERNAL_BASE_URL=http://auth:8000

# ---- Shared ----
INTERNAL_JWT_ISSUER=http://localhost:3000/auth
INTERNAL_JWT_AUDIENCE=fantasy-api
INTERNAL_SERVICE_TOKEN=dev-service-token
MIGRATION_AUTO_APPLY=false

# ---- Scraping (profiles: apps, full) ----
SCRAPING_SERVICE_PORT=8002
SCRAPING_PUBLISH_PORT=8002
SCRAPING_BASE_URL=http://scraping:8002
SCRAPING_SERVICE_TOKEN=dev-scraping-token
SCRAPING_REDIS_URL=redis://redis:6379/1
SCRAPER_CONTACT=you@example.com
