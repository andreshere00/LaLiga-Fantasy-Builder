project_id = "your-existing-project-id"
# Region and zone must change together.
region       = "us-central1"
zone         = "us-central1-a"
domain       = "fantasybuilder.es"
machine_type = "e2-small"
admin_members = [
  "user:your-google-account@example.com",
]

# Optional: this needs permission to create budgets on the billing account.
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# budget_currency    = "EUR" # Must match your billing account, not the USD estimate.
# monthly_budget     = 20
