# Upload to <prefix>-identity-env. Never use a development secret.
# BETTER_AUTH_SECRET: openssl rand -hex 32; preserve it across releases/restarts.
BETTER_AUTH_SECRET=
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=noreply@fantasybuilder.es
# Optional social providers: omit unused keys entirely, rather than setting blank values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY= (PEM with literal \n)
