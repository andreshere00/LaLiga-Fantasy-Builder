NODE_ENV=development
PORT=8003
BETTER_AUTH_URL=http://localhost:3000
# Generate an independent random secret for each deployment; never rotate without a plan.
BETTER_AUTH_SECRET=development-only-replace-with-random-secret-32-chars
IDENTITY_DATABASE_URL=postgresql://fantasy_identity:identity_dev@localhost:5432/fantasy_identity
INTERNAL_JWT_ISSUER=http://localhost:3000/auth
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=accounts@localhost.test
# SMTP_USER and SMTP_PASSWORD are required in production (TLS is enforced).
# Direct providers are optional. Set every field for each one you enable and
# register its callback at ${BETTER_AUTH_URL}/auth/callback/{provider}.
# LaLiga SSO is unavailable until its separate approved web client is proven.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY= (PEM, literal \n supported; generated secrets renew automatically)
