{
  "openapi": "3.1.0",
  "info": {
    "title": "LaLiga Fantasy Builder Auth",
    "description": "LaLiga Fantasy Builder **auth** service.\n\nApplication authentication is owned by Better Auth at ``/auth`` on the identity\nservice. LaLiga connection and pairing creation require its Ed25519 Bearer JWT.\nThe registered HTTPS browser callback and native helper completion use single-use\nserver challenges, not browser cookies. Browser linking is unavailable until its\nexact HTTPS redirect URI is configured and registered with LaLiga.\n\n``/internal/*`` routes require the internal JWT **and** ``X-Service-Token`` on\na private network. They must not be exposed on the public internet.",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/laliga/bearer": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "Get Laliga Bearer",
        "description": "Return a valid LaLiga bearer for the JWT subject.\n\nRequires both a valid internal JWT and the shared service token.\nThe user id is taken only from the JWT ``sub`` claim.\n\nArgs:\n    request: Incoming request (unused; kept for ASGI consistency).\n    authorization: ``Bearer <internal JWT>``.\n    x_service_token: Shared service credential.\n\nReturns:\n    LaLiga bearer and expiry (no refresh token).",
        "operationId": "get_laliga_bearer_internal_laliga_bearer_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "name": "X-Service-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaligaBearerResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/link-options": {
      "get": {
        "tags": [
          "laliga"
        ],
        "summary": "Link Options",
        "description": "Describe enabled linking journeys to a verified application user.",
        "operationId": "link_options_laliga_link_options_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkOptionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/manual/start": {
      "post": {
        "tags": [
          "laliga"
        ],
        "summary": "Manual Start",
        "description": "Start an explicitly requested, owner and browser bound native pairing.",
        "operationId": "manual_start_laliga_manual_start_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualStartResponse"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/manual/complete": {
      "post": {
        "tags": [
          "laliga"
        ],
        "summary": "Manual Complete",
        "description": "Exchange a pasted callback only for its initiating user and browser.",
        "operationId": "manual_complete_laliga_manual_complete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualCompleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStatusResponse"
                }
              }
            }
          },
          "413": {
            "description": "Callback request too large.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/manual/pending": {
      "delete": {
        "tags": [
          "laliga"
        ],
        "summary": "Manual Cancel",
        "description": "Cancel only the current user's pending manual attempt in this browser.",
        "operationId": "manual_cancel_laliga_manual_pending_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/pairings": {
      "post": {
        "tags": [
          "laliga"
        ],
        "summary": "Create Pairing",
        "description": "Create a one-time pairing for the authenticated app user.\n\nArgs:\n    request: Incoming request.\n\nReturns:\n    Pairing ID, secret (shown once), expiry, and expected nonce.",
        "operationId": "create_pairing_laliga_pairings_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingCreateResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "laliga"
        ],
        "summary": "Cancel Pairings",
        "description": "Cancel the verified user's outstanding browser and helper challenges.",
        "operationId": "cancel_pairings_laliga_pairings_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/login": {
      "post": {
        "tags": [
          "laliga"
        ],
        "summary": "Laliga Login",
        "description": "Start browser LaLiga delegation through a registered HTTPS callback.\n\nA random HttpOnly cookie binds the challenge to this browser; the callback\nrejects any other browser, so a victim cannot be linked to this account.",
        "operationId": "laliga_login_laliga_login_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserLoginResponse"
                }
              }
            }
          },
          "503": {
            "description": "Browser callback unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/callback": {
      "get": {
        "tags": [
          "laliga"
        ],
        "summary": "Laliga Browser Callback",
        "description": "Complete a browser authorization and return to the fixed frontend origin.",
        "operationId": "laliga_browser_callback_laliga_callback_get",
        "responses": {
          "303": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/laliga/pairings/complete-redirect": {
      "post": {
        "tags": [
          "laliga"
        ],
        "summary": "Complete Redirect",
        "description": "Finish pairing from a native ``authredirect://`` callback.\n\nThe URL handler posts the callback. Tokens stay inside auth. The response\ntells the handler which frontend origin to open.\n\nArgs:\n    body: Full native callback URL.\n    request: Used for client IP rate limiting.\n\nReturns:\n    Completion flag and frontend origin. No tokens or pairing secrets.\n\nRaises:\n    PairingError: When the callback does not match a pending challenge.",
        "operationId": "complete_redirect_laliga_pairings_complete_redirect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteRedirectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteRedirectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/pairings/{pairing_id}/complete": {
      "post": {
        "tags": [
          "laliga"
        ],
        "summary": "Complete Pairing",
        "description": "Complete pairing from the local PKCE helper (rate-limited).\n\nThis endpoint is called by the helper CLI, not the browser, so it uses\nthe pairing secret as its independent one-time proof.\n\nArgs:\n    pairing_id: Public pairing identifier.\n    body: Secret + raw B2C token response.\n    request: Used for client IP rate limiting.\n\nReturns:\n    Completion status with manager profile fields (no tokens).",
        "operationId": "complete_pairing_laliga_pairings__pairing_id__complete_post",
        "parameters": [
          {
            "name": "pairing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pairing Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairingCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingCompleteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/laliga/connection": {
      "get": {
        "tags": [
          "laliga"
        ],
        "summary": "Get Connection",
        "description": "Return LaLiga connection status for the current user.\n\nArgs:\n    request: Incoming request.\n\nReturns:\n    Public status without tokens.",
        "operationId": "get_connection_laliga_connection_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStatusResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "laliga"
        ],
        "summary": "Delete Connection",
        "description": "Remove sealed LaLiga tokens for the current user.\n\nArgs:\n    request: Incoming request.\n\nReturns:\n    ``{\"ok\": true}``.",
        "operationId": "delete_connection_laliga_connection_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Live",
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Live",
        "operationId": "health_live_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Ready",
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthNotReadyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "AuthErrorResponse",
        "description": "Sanitized error shape returned by auth routes."
      },
      "BrowserLoginResponse": {
        "properties": {
          "authorize_url": {
            "type": "string",
            "title": "Authorize Url"
          }
        },
